<%- include('../partials/header') %>
<h1>Admin panel</h1>
<section class="stats">
  <div class="stat"><strong><%= stats.users %></strong><span>Users</span></div>
  <div class="stat"><strong><%= stats.organizers %></strong><span>Organizers</span></div>
  <div class="stat"><strong><%= stats.events %></strong><span>Events</span></div>
  <div class="stat"><strong><%= stats.upcoming %></strong><span>Upcoming</span></div>
  <div class="stat"><strong><%= stats.registrations %></strong><span>Registrations</span></div>
  <div class="stat"><strong><%= stats.registrations ? Math.round(stats.attended * 100 / stats.registrations) : 0 %>%</strong><span>Attendance</span></div>
</section>

<section class="card">
  <h2>By category</h2>
  <% if (!byCategory.length) { %><p class="muted">No events yet.</p><% } else { %>
    <% const max = Math.max(1, ...byCategory.map((c) => c.registrations)); %>
    <div class="bars">
      <% byCategory.forEach((c) => { %>
        <div class="bar-row">
          <span class="bar-label"><%= c.category %></span>
          <span class="bar"><span style="width: <%= (c.registrations / max) * 100 %>%"></span></span>
          <span class="bar-value"><%= c.registrations %> regs · <%= c.events %> events</span>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card">
  <h2>Users</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Role</th><th></th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td><%= u.department || '—' %></td>
            <td>
              <% if (u.id === currentUser.id) { %>
                <%= u.role %> (you)
              <% } else { %>
                <form method="post" action="/admin/users/<%= u.id %>/role" class="inline">
                  <select name="role" onchange="this.form.submit()" aria-label="Role for <%= u.name %>">
                    <% ['student', 'organizer', 'admin'].forEach((r) => { %><option <%= u.role === r ? 'selected' : '' %>><%= r %></option><% }) %>
                  </select>
                  <noscript><button class="link" type="submit">Save</button></noscript>
                </form>
              <% } %>
            </td>
            <td>
              <% if (u.id !== currentUser.id) { %>
                <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Delete this user? Their events and registrations will be removed.')">
                  <button class="link danger" type="submit">Delete</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
